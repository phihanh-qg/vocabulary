<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ACTIVERECALL • KIỂM TRA NHANH"
                    android:textColor="#059669"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <Button
                    android:id="@+id/qr_btn_close"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Đóng"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:backgroundTint="#F1F5F9"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp" />
            </LinearLayout>

            <!-- Word Prompt (NO meaning shown initially) -->
            <TextView
                android:id="@+id/qr_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="resilient"
                android:textColor="#0F172A"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/qr_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="(adj)  /rɪˈzɪl.i.ənt/"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/qr_btn_speak"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🔊 Nghe"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#047857"
                    android:backgroundTint="#ECFDF5" />
            </LinearLayout>

            <!-- Input box -->
            <EditText
                android:id="@+id/qr_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:hint="Nhập nghĩa tiếng Việt để kiểm tra..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:background="#F1F5F9"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/qr_btn_check"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Kiểm tra"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/qr_btn_reveal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Hiện nghĩa"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#334155"
                    android:backgroundTint="#E2E8F0" />
            </LinearLayout>

            <!-- Result Box (hidden until checked) -->
            <LinearLayout
                android:id="@+id/qr_result_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="#F0FDF4"
                android:visibility="gone">

                <TextView
                    android:id="@+id/qr_result_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Chính xác!"
                    android:textColor="#047857"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/qr_result_meaning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nghĩa: kiên cường, phục hồi nhanh"
                    android:textColor="#0F172A"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/qr_result_example"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ví dụ: ..."
                    android:textColor="#475569"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <Button
                    android:id="@+id/qr_btn_next"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:text="Từ tiếp theo →"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0F172A" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
