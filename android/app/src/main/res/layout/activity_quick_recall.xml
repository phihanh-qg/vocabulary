<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qr_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="56dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/qr_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/lockscreen_glass_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Top row: Word + Speak + Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/qr_word"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="resilient"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/qr_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(adj)  /rɪˈzɪl.i.ənt/"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/qr_btn_speak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="18sp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/qr_btn_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕"
                android:textColor="#CBD5E1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Compact input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/qr_input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Nhập nghĩa..."
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:background="#26FFFFFF"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/qr_btn_check"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Check"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                android:minWidth="64dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/qr_btn_reveal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="?"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E2E8F0"
                android:backgroundTint="#33FFFFFF"
                android:minWidth="40dp" />
        </LinearLayout>

        <!-- Result Box (hidden until checked) -->
        <LinearLayout
            android:id="@+id/qr_result_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#26FFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/qr_result_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Chính xác!"
                android:textColor="#34D399"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qr_result_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nghĩa: ..."
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/qr_result_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ví dụ: ..."
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:textStyle="italic" />

            <Button
                android:id="@+id/qr_btn_next"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:text="Từ tiếp theo →"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:backgroundTint="#E2E8F0" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
